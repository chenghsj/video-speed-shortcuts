{
  "name": "video-speed-shortcuts",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenghsj/video-speed-shortcuts.git"
  },
  "bugs": {
